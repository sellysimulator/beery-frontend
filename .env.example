# Backend REST base. Empty falls back to the Vite dev proxy on /api.
VITE_API_BASE_URL=

# Socket.IO origin. Must point directly at the backend host in production:
# Firebase Hosting does not proxy WebSocket upgrades (00-decisions.md D17).
VITE_SOCKET_URL=

# The Firebase web config is NOT here. It lives as literals in firebase.ts, which is
# committed: those six values are public identifiers that ship in the bundle anyway,
# and keeping them in one committed file is what lets CI build the frontend.
